# ====== المتغيرات الخاصة بمشروع ركشتك ======
# انسخ هذا الملف إلى .env.local وأدخل القيم الحقيقية — لا ترفع .env.local إلى Git أبداً.
 
# ── بوابة الإدارة (أضِفه في Vercel أيضاً ثم أعد النشر) ──
# أي سلسلة طويلة عشوائية — توليد: openssl rand -hex 24
# بدونه تبقى /admin و /dashboard وكل مسارات /api الإدارية مقفولة (403) — وضع آمن متعمّد.
RAKSHTAK_ADMIN_TOKEN=
 
# ── قاعدة بيانات Neon (طبقة المسارات القديمة — ستُستبدل بـ Supabase في المرحلة 2) ──
DATABASE_URL=
 
# ── Supabase (التطبيق الحي: طلب المشوار + لوحة السائق + لوحة الأدمن) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
 
# ── Pusher (إشعارات فورية للمسارات القديمة) ──
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
 
# ── (احتياطي للمرحلة 2) نقطة إرسال رمز OTP — حتى تُضبط، /api/auth/login موقوف بـ 503 ──
# RAKSHTAK_OTP_WEBHOOK_URL=
